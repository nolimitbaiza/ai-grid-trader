# Web server for the Railway deployment (see Dockerfile). Railway provides $PORT.
#   /                 home page (about me)
#   /ai-grid-trader   the AI Grid Trader demo (ai-grid-trader.html)
:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Old and alternative addresses.
	redir /about.html / permanent
	redir /ai-grid-trader.html /ai-grid-trader{query} permanent
	redir /ai-grid-trader/ /ai-grid-trader{query} permanent

	# Clean URLs: /ai-grid-trader serves ai-grid-trader.html.
	try_files {path} {path}.html

	# Caching: browsers and CDNs (Cloudflare) must re-check every file with the server, so a new
	# release is never mixed with old copies. Files a page loads also carry a ?v= build stamp
	# (see Dockerfile). Plotly's filename includes its version, so it can be kept for a year.
	@vendor path /assets/vendor/*
	@site not path /assets/vendor/*
	header @site Cache-Control "no-cache"
	header @vendor Cache-Control "public, max-age=31536000, immutable"

	file_server
}
